@model ShoeStore.Client.Models.RegisterViewModel

@{
    ViewData["Title"] = "Đăng ký";
}

<!-- Header -->
<header class="masthead bg-success text-white text-center" style="padding-top: 120px; padding-bottom: 60px;">
    <div class="container d-flex align-items-center flex-column">
        <h1 class="masthead-heading text-uppercase mb-0">Đăng ký tài khoản</h1>
        <div class="divider-custom divider-light">
            <div class="divider-custom-line"></div>
            <div class="divider-custom-icon"><i class="fas fa-user-plus"></i></div>
            <div class="divider-custom-line"></div>
        </div>
        <p class="masthead-subheading font-weight-light mb-0">Tạo tài khoản mới để bắt đầu mua sắm</p>
    </div>
</header>

<!-- Register Section -->
<section class="page-section" style="padding-top: 80px; padding-bottom: 80px;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 col-md-10">
                <div class="card shadow-lg border-0">
                    <div class="card-body p-5">
                        <form asp-action="Register" method="post">
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                            
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-floating mb-3">
                                        <input asp-for="Username" class="form-control" placeholder="Tên đăng nhập" />
                                        <label asp-for="Username">Tên đăng nhập</label>
                                        <span asp-validation-for="Username" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating mb-3">
                                        <input asp-for="Email" class="form-control" placeholder="Email" />
                                        <label asp-for="Email">Email</label>
                                        <span asp-validation-for="Email" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-floating mb-3">
                                        <input asp-for="Password" class="form-control" placeholder="Mật khẩu" />
                                        <label asp-for="Password">Mật khẩu</label>
                                        <span asp-validation-for="Password" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating mb-3">
                                        <input asp-for="ConfirmPassword" class="form-control" placeholder="Xác nhận mật khẩu" />
                                        <label asp-for="ConfirmPassword">Xác nhận mật khẩu</label>
                                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-floating mb-3">
                                        <input asp-for="FullName" class="form-control" placeholder="Họ tên" />
                                        <label asp-for="FullName">Họ tên</label>
                                        <span asp-validation-for="FullName" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating mb-3">
                                        <input asp-for="Phone" class="form-control" placeholder="Số điện thoại" />
                                        <label asp-for="Phone">Số điện thoại</label>
                                        <span asp-validation-for="Phone" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="form-floating mb-4">
                                <textarea asp-for="Address" class="form-control" placeholder="Địa chỉ" style="height: 100px"></textarea>
                                <label asp-for="Address">Địa chỉ</label>
                                <span asp-validation-for="Address" class="text-danger"></span>
                            </div>
                            
                            <div class="d-grid">
                                <button type="submit" class="btn btn-success btn-lg">
                                    <i class="fas fa-user-plus me-2"></i>Đăng ký
                                </button>
                            </div>
                        </form>
                        
                        <hr class="my-4">
                        
                        <div class="text-center">
                            <p class="mb-0">Đã có tài khoản? 
                                <a asp-action="Login" class="text-decoration-none">Đăng nhập ngay</a>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
} 