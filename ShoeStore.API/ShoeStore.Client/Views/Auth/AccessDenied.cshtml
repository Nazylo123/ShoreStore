@{
    ViewData["Title"] = "Truy cập bị từ chối";
}

<!-- Header -->
<header class="masthead bg-danger text-white text-center" style="padding-top: 120px; padding-bottom: 60px;">
    <div class="container d-flex align-items-center flex-column">
        <h1 class="masthead-heading text-uppercase mb-0">Truy cập bị từ chối</h1>
        <div class="divider-custom divider-light">
            <div class="divider-custom-line"></div>
            <div class="divider-custom-icon"><i class="fas fa-exclamation-triangle"></i></div>
            <div class="divider-custom-line"></div>
        </div>
        <p class="masthead-subheading font-weight-light mb-0">Bạn không có quyền truy cập trang này</p>
    </div>
</header>

<!-- Access Denied Section -->
<section class="page-section" style="padding-top: 80px; padding-bottom: 80px;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6 text-center">
                <div class="card shadow-lg border-0">
                    <div class="card-body p-5">
                        <i class="fas fa-lock fa-4x text-danger mb-4"></i>
                        <h3 class="mb-4">Truy cập bị từ chối</h3>
                        <p class="text-muted mb-4">
                            Xin lỗi, bạn không có quyền truy cập vào trang này. 
                            Vui lòng đăng nhập với tài khoản có quyền phù hợp hoặc liên hệ quản trị viên.
                        </p>
                        <div class="d-grid gap-2">
                            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                                <i class="fas fa-home me-2"></i>Về trang chủ
                            </a>
                            <a asp-action="Login" class="btn btn-outline-primary">
                                <i class="fas fa-sign-in-alt me-2"></i>Đăng nhập
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section> 