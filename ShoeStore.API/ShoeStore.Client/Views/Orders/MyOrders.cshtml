@model List<ShoeStore.Client.Models.OrderViewModel>
@{
    ViewData["Title"] = "Đơn hàng của tôi";
}
<div class="container py-5">
    <h2 class="mb-4"><i class="fas fa-shopping-bag me-2"></i>Đơn hàng của tôi</h2>
    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">Bạn chưa có đơn hàng nào.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Mã đơn</th>
                        <th>Ngày đặt</th>
                        <th>Trạng thái</th>
                        <th>Tổng tiền</th>
                        <th>Chi tiết</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td>@order.Id</td>
                            <td>@order.FormattedOrderDate</td>
                            <td>@order.Status</td>
                            <td>@order.FormattedTotalAmount</td>
                            <td>
                                <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Detail", "Orders", new { id = order.Id })">
                                    <i class="fas fa-eye"></i> Xem
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div> 