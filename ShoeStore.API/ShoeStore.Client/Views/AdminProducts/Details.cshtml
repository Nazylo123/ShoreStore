@model ShoeStore.Client.Models.ProductViewModel
@{
    ViewData["Title"] = "Chi tiết sản phẩm";
}
<h2 class="mb-4">Chi tiết sản phẩm</h2>
<div class="card mb-4">
    <div class="row g-0">
        <div class="col-md-4">
            <img src="@Model.ImageUrl" class="img-fluid rounded-start" alt="@Model.Name" />
        </div>
        <div class="col-md-8">
            <div class="card-body">
                <h5 class="card-title">@Model.Name</h5>
                <p class="card-text">@Model.Description</p>
                <p class="card-text"><strong>Giá:</strong> @Model.Price.ToString("N0") VNĐ</p>
                <p class="card-text"><strong>Số lượng tồn:</strong> @Model.StockQuantity</p>
                <p class="card-text"><strong>Thương hiệu:</strong> @Model.BrandName</p>
                <p class="card-text"><strong>Danh mục:</strong> @Model.CategoryName</p>
                <p class="card-text"><strong>Trạng thái:</strong> @(Model.IsActive ? "Hiện" : "Ẩn")</p>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Sửa</a>
                <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
            </div>
        </div>
    </div>
</div> 