@{
    ViewData["Title"] = "Giới thiệu";
}

<div class="container py-4">
    <!-- Hero Section -->
    <div class="row mb-5">
        <div class="col-lg-6">
            <h1 class="display-4 fw-bold mb-4">Về ShoeStore</h1>
            <p class="lead mb-4">Chúng tôi là cửa hàng giày uy tín với hơn 10 năm kinh nghiệm trong lĩnh vực bán lẻ giày dép chất lượng cao.</p>
            <p class="mb-4">Với sứ mệnh mang đến những đôi giày chất lượng, thiết kế đẹp và giá cả hợp lý cho mọi khách hàng, ShoeStore đã và đang trở thành điểm đến tin cậy của những người yêu thích thời trang.</p>
        </div>
    </div>

    <!-- Mission & Vision -->
    <div class="row mb-5">
        <div class="col-md-6 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <i class="fas fa-bullseye fa-3x text-primary mb-3"></i>
                    <h4 class="card-title">Sứ mệnh</h4>
                    <p class="card-text">Cung cấp những sản phẩm giày chất lượng cao với thiết kế hiện đại, đáp ứng mọi nhu cầu của khách hàng từ công sở đến dạo phố.</p>
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <i class="fas fa-eye fa-3x text-success mb-3"></i>
                    <h4 class="card-title">Tầm nhìn</h4>
                    <p class="card-text">Trở thành thương hiệu giày hàng đầu Việt Nam, được khách hàng tin tưởng và lựa chọn cho mọi dịp.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Values -->
    <div class="row mb-5">
        <div class="col-12">
            <h2 class="text-center mb-4">Giá trị cốt lõi</h2>
        </div>
        <div class="col-md-3 mb-4">
            <div class="text-center">
                <i class="fas fa-star fa-2x text-warning mb-3"></i>
                <h5>Chất lượng</h5>
                <p class="text-muted">Cam kết chất lượng sản phẩm tốt nhất</p>
            </div>
        </div>
        <div class="col-md-3 mb-4">
            <div class="text-center">
                <i class="fas fa-heart fa-2x text-danger mb-3"></i>
                <h5>Tận tâm</h5>
                <p class="text-muted">Phục vụ khách hàng với sự tận tâm cao nhất</p>
            </div>
        </div>
        <div class="col-md-3 mb-4">
            <div class="text-center">
                <i class="fas fa-handshake fa-2x text-info mb-3"></i>
                <h5>Uy tín</h5>
                <p class="text-muted">Xây dựng niềm tin với khách hàng</p>
            </div>
        </div>
        <div class="col-md-3 mb-4">
            <div class="text-center">
                <i class="fas fa-lightbulb fa-2x text-warning mb-3"></i>
                <h5>Sáng tạo</h5>
                <p class="text-muted">Không ngừng đổi mới và sáng tạo</p>
            </div>
        </div>
    </div>

    <!-- History -->
    <div class="row mb-5">
        <div class="col-12">
            <h2 class="text-center mb-4">Lịch sử phát triển</h2>
        </div>
        <div class="col-md-6">
            <div class="timeline">
                <div class="timeline-item">
                    <div class="timeline-marker bg-primary"></div>
                    <div class="timeline-content">
                        <h5>2015</h5>
                        <p>Thành lập cửa hàng đầu tiên tại TP.HCM</p>
                    </div>
                </div>
                <div class="timeline-item">
                    <div class="timeline-marker bg-success"></div>
                    <div class="timeline-content">
                        <h5>2018</h5>
                        <p>Mở rộng chuỗi cửa hàng ra 5 tỉnh thành</p>
                    </div>
                </div>
                <div class="timeline-item">
                    <div class="timeline-marker bg-warning"></div>
                    <div class="timeline-content">
                        <h5>2020</h5>
                        <p>Phát triển kênh bán hàng online</p>
                    </div>
                </div>
                <div class="timeline-item">
                    <div class="timeline-marker bg-info"></div>
                    <div class="timeline-content">
                        <h5>2025</h5>
                        <p>Trở thành thương hiệu giày hàng đầu</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Team -->
    <!-- Đã xóa toàn bộ phần team, chỉ giữ lại các phần text về cửa hàng, sứ mệnh, tầm nhìn, giá trị cốt lõi, lịch sử phát triển. -->
</div>

<style>
    .timeline {
        position: relative;
        padding-left: 30px;
    }

    .timeline-item {
        position: relative;
        margin-bottom: 30px;
    }

    .timeline-marker {
        position: absolute;
        left: -45px;
        top: 0;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        border: 3px solid #fff;
        box-shadow: 0 0 0 3px #dee2e6;
    }

    .timeline-content {
        padding-left: 20px;
        border-left: 2px solid #dee2e6;
        padding-bottom: 20px;
    }

    .timeline-content h5 {
        color: #007bff;
        margin-bottom: 10px;
    }
</style> 