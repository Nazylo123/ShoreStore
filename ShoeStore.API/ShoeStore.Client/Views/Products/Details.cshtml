@model ShoeStore.Client.Models.ProductViewModel
@{
    ViewData["Title"] = Model.Name;
}

<div class="container py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Trang chủ</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Products")">Sản phẩm</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Category", "Products", new { id = Model.CategoryId })">@Model.CategoryName</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
        </ol>
    </nav>

    <div class="row">
        <!-- Product Image -->
        <div class="col-md-6 mb-4">
            <div class="card">
                <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/default-shoe.jpg" : Model.ImageUrl)" class="card-img-top img-fluid" alt="@Model.Name" style="width: 100%; height: 400px; object-fit: cover;">
            </div>
        </div>

        <!-- Product Details -->
        <div class="col-md-6">
            <h1 class="h3 mb-3">@Model.Name</h1>
            
            <div class="mb-3">
                <span class="badge bg-primary me-2">@Model.BrandName</span>
                <span class="badge bg-secondary">@Model.CategoryName</span>
            </div>

            <div class="mb-3">
                <h3 class="text-primary fw-bold">@Model.FormattedPrice</h3>
            </div>

            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <div class="mb-4">
                    <h5>Mô tả sản phẩm</h5>
                    <p class="text-muted">@Model.Description</p>
                </div>
            }

            <!-- Add to Cart Form -->
            <form asp-controller="Cart" asp-action="AddToCart" method="post" class="mb-4">
                <input type="hidden" name="ProductId" value="@Model.Id" />
                
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Kích thước</label>
                        <select class="form-select" name="Size" id="sizeSelect" required>
                            <option value="">Chọn kích thước</option>
                            @foreach (var variant in Model.Variants.Where(v => v.Stock > 0))
                            {
                                <option value="@variant.Size" data-stock="@variant.Stock">
                                    Size @variant.Size (@variant.Stock sản phẩm)
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Số lượng</label>
                        <input type="number" class="form-control" name="Quantity" id="quantityInput" 
                               value="1" min="1" max="10" required>
                        <div class="form-text">Tối đa 10 sản phẩm</div>
                    </div>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary btn-lg" id="addToCartBtn">
                        <i class="fas fa-cart-plus me-2"></i>Thêm vào giỏ hàng
                    </button>
                    <a href="@Url.Action("Index", "Cart")" class="btn btn-outline-primary">
                        <i class="fas fa-shopping-cart me-2"></i>Xem giỏ hàng
                    </a>
                </div>
            </form>

            <!-- Product Info -->
            <div class="card">
                <div class="card-body">
                    <h6 class="card-title">Thông tin sản phẩm</h6>
                    <ul class="list-unstyled">
                        <li><i class="fas fa-tag me-2 text-muted"></i>Thương hiệu: @Model.BrandName</li>
                        <li><i class="fas fa-th-large me-2 text-muted"></i>Danh mục: @Model.CategoryName</li>
                        <li><i class="fas fa-calendar me-2 text-muted"></i>Ngày tạo: @Model.CreatedAt.ToString("dd/MM/yyyy")</li>
                        <li><i class="fas fa-check-circle me-2 text-success"></i>Tình trạng: @(Model.IsActive ? "Còn hàng" : "Hết hàng")</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- Available Sizes -->
    @if (Model.Variants.Any())
    {
        <div class="row mt-5">
            <div class="col-12">
                <h4>Kích thước có sẵn</h4>
                <div class="row">
                    @foreach (var variant in Model.Variants)
                    {
                        <div class="col-md-2 col-sm-4 col-6 mb-2">
                            <div class="card text-center @(variant.Stock > 0 ? "border-success" : "border-danger")">
                                <div class="card-body py-2">
                                    <h6 class="card-title mb-1">Size @variant.Size</h6>
                                    <small class="@(variant.Stock > 0 ? "text-success" : "text-danger")">
                                        @(variant.Stock > 0 ? $"{variant.Stock} sản phẩm" : "Hết hàng")
                                    </small>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <!-- Related Products -->
    <div class="row mt-5">
        <div class="col-12">
            <h4>Sản phẩm liên quan</h4>
            <div class="row" id="relatedProducts">
                <!-- Related products will be loaded here -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Update quantity max based on selected size
            $('#sizeSelect').change(function() {
                var selectedOption = $(this).find('option:selected');
                var stock = selectedOption.data('stock');
                if (stock) {
                    $('#quantityInput').attr('max', Math.min(stock, 10));
                }
            });

            // Form validation
            $('form').submit(function(e) {
                var size = $('#sizeSelect').val();
                var quantity = $('#quantityInput').val();
                
                if (!size) {
                    e.preventDefault();
                    alert('Vui lòng chọn kích thước');
                    return false;
                }
                
                if (quantity < 1 || quantity > 10) {
                    e.preventDefault();
                    alert('Số lượng phải từ 1 đến 10');
                    return false;
                }
            });

            // Load related products
            loadRelatedProducts();
        });

        function loadRelatedProducts() {
            $.get('/Products/GetRelatedProducts/@Model.Id', function(products) {
                var container = $('#relatedProducts');
                products.forEach(function(product) {
                    container.append(`
                        <div class="col-md-3 col-sm-6 mb-3">
                            <div class="card h-100">
                                <img src="${product.imageUrl || '/images/default-shoe.jpg'}" class="card-img-top img-fluid" alt="${product.name}" style="width: 100%; height: 150px; object-fit: cover;">
                                <div class="card-body">
                                    <h6 class="card-title">${product.name}</h6>
                                    <p class="card-text text-primary fw-bold">${product.formattedPrice}</p>
                                    <a href="/Products/Details/${product.id}" class="btn btn-outline-primary btn-sm">Xem chi tiết</a>
                                </div>
                            </div>
                        </div>
                    `);
                });
            });
        }
    </script>
} 